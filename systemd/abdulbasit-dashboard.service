[Unit]
Description=Abdul Basit loopback web dashboard
After=network.target abdulbasit-paneld.service
Wants=abdulbasit-paneld.service
ConditionPathExists=/etc/abdulbasit/dashboard_auth.json

[Service]
Type=simple
User=abdulbasit-dashboard
Group=abdulbasit-dashboard
SupplementaryGroups=abdulbasit
ExecStart=/usr/bin/python3 /usr/local/lib/abdulbasit/dashboard.py
Restart=on-failure
RestartSec=3s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/abdulbasit /usr/local/share/abdulbasit-dashboard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
