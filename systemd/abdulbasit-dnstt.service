[Unit]
Description=Abdul Basit DNSTT to Dropbear tunnel
After=network-online.target dropbear.service
Wants=network-online.target dropbear.service
ConditionPathExists=/etc/abdulbasit/dnstt.json

[Service]
Type=simple
User=abdulbasit-dnstt
Group=abdulbasit-dnstt
SupplementaryGroups=abdulbasit
ExecStart=/usr/bin/python3 /usr/local/lib/abdulbasit/dnstt_runner.py
Restart=on-failure
RestartSec=3s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/abdulbasit/dnstt.json /etc/abdulbasit/dnstt /usr/local/bin/dnstt-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
