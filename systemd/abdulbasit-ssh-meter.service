[Unit]
Description=NOWAY authenticated SSH payload accounting
Before=dropbear.service
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/lib/abdulbasit/python /usr/local/lib/abdulbasit/ssh_meter.py
Restart=on-failure
RestartSec=2s
UMask=0077
RuntimeDirectory=abdulbasit-meter
RuntimeDirectoryMode=0711
StateDirectory=abdulbasit-meter
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/abdulbasit
ReadWritePaths=/var/lib/abdulbasit-meter /run/abdulbasit-meter
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
