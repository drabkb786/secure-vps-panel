[Unit]
Description=Abdul Basit loopback WebSocket-to-Dropbear proxy
After=network.target dropbear.service
Wants=dropbear.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=abdulbasit-gateway
RuntimeDirectory=abdulbasit-ws
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/abdulbasit/ws_proxy.py
Restart=on-failure
RestartSec=2s
UMask=0077
MemoryMax=256M
TasksMax=256
LimitNOFILE=1024

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
