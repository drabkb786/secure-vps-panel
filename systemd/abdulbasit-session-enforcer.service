[Unit]
Description=Abdul Basit managed SSH session and IP enforcer
After=abdulbasit-sshd.service dropbear.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/lib/abdulbasit/python /usr/local/lib/abdulbasit/session_enforcer.py
Restart=on-failure
RestartSec=3s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/abdulbasit
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
