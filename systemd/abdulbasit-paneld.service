[Unit]
Description=Abdul Basit privileged panel command daemon
After=network.target
Before=abdulbasit-bot.service

[Service]
Type=simple
User=root
Group=abdulbasit
ExecStart=/usr/bin/python3 /usr/local/lib/abdulbasit/paneld.py
Restart=on-failure
RestartSec=3s
RuntimeDirectory=abdulbasit
RuntimeDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
# shadow-utils needs temporary/lock files beside /etc/passwd and /etc/shadow.
# Binding only the individual files read-write breaks useradd/usermod.
ReadWritePaths=/etc /var/lib/letsencrypt /var/log/letsencrypt /var/www/letsencrypt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
