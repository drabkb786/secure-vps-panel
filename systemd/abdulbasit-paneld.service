[Unit]
Description=Abdul Basit privileged panel command daemon
After=network.target
Before=abdulbasit-bot.service

[Service]
Type=simple
User=root
Group=abdulbasit
ExecStart=/usr/bin/python3 /usr/local/lib/abdulbasit/paneld.py
Restart=on-failure
RestartSec=3s
RuntimeDirectory=abdulbasit
RuntimeDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
# Keep /usr and boot files read-only. This privileged daemon must write /etc:
# shadow-utils needs sibling lock/temp files, and managed configs use rename.
# Avoid competing read-only/full and read-write rules on the same /etc mount.
ProtectSystem=yes
ReadWritePaths=/etc /var/lib/letsencrypt /var/log/letsencrypt /var/www/letsencrypt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
