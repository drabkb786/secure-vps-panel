[Unit]
Description=Abdul Basit unprivileged Telegram management bot
After=network-online.target abdulbasit-paneld.service
Wants=network-online.target abdulbasit-paneld.service
ConditionPathExists=/etc/abdulbasit/bot_token.conf

[Service]
Type=simple
User=abdulbasit-bot
Group=abdulbasit
ExecStart=/usr/local/lib/abdulbasit/python /usr/local/lib/abdulbasit/tgbot.py
Restart=on-failure
RestartSec=5s
StateDirectory=abdulbasit-bot
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/abdulbasit
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
